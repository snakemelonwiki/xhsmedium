+            onChange={(e) => setRawKeyword(e.target.value)}
+          />
+          <Button onClick={() => void load()}>刷新</Button>
+        </Space>
+      </Card>
+
+      {/* 销售分组列表 */}
+      <Spin spinning={loading}>
+        {groups.length === 0 ? (
+          <Card><Empty description="暂无客资" /></Card>
