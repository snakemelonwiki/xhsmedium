+import { Controller, Get, Post, Patch, Delete, Body, Param, Query, Req, Res, UseGuards } from '@nestjs/common';
+import { Request, Response } from 'express';
+import { AuthGuard } from '../../common/auth.guard';
+import { getSessionUserId, getSessionRole } from '../../common/session.utils';
+import { FinanceService } from './finance.service';
+
+/** 财务系统：owner / admin 可访问（supervisor 仅前端菜单可见性控制，后端不开放）。 */
+function ensureFinanceAccess(req: any, res: Response): boolean {
+  const role = getSessionRole(req);
+  if (!['owner', 'admin'].includes(role)) {
+    res.status(403).json({ ok: false, message: 'forbidden: 无权访问财务系统' });
+    return false;
+  }
+  return true;
+}
+
+@Controller('finance')
+@UseGuards(AuthGuard)
+export class FinanceController {
+  constructor(private readonly service: FinanceService) {}
+
+  // === 订单收入 ===
+
+  @Get('order-income')
+  async listOrderIncome(
+    @Query() query: any,
+    @Req() req: Request,
+    @Res() res: Response,
+  ) {
+    if (!ensureFinanceAccess(req, res)) return;
+    try {
+      const result = await this.service.listOrderIncome(query);
+      return res.json(result);
+    } catch (err: any) {
+      return res.status(500).json({ ok: false, message: err?.message || 'failed' });
+    }
+  }
+
+  // === 订单支出（老师付款） ===
+
+  @Get('teacher-payments')
+  async listTeacherPayments(
+    @Query() query: any,
+    @Req() req: Request,
+    @Res() res: Response,
+  ) {
+    if (!ensureFinanceAccess(req, res)) return;
+    try {
+      const result = await this.service.listTeacherPayments(query);
+      return res.json(result);
+    } catch (err: any) {
+      return res.status(500).json({ ok: false, message: err?.message || 'failed' });
+    }
+  }
+
+  @Post('teacher-payments')
+  async createTeacherPayment(
+    @Body() body: any,
+    @Req() req: Request,
+    @Res() res: Response,
+  ) {
+    if (!ensureFinanceAccess(req, res)) return;
+    try {
+      const userId = getSessionUserId(req) || '';
+      const result = await this.service.createTeacherPayment(body, userId);
+      return res.json({ ok: true, data: result });
+    } catch (err: any) {
+      return res.status(422).json({ ok: false, message: err?.message || 'failed' });
+    }
+  }
+
+  @Patch('teacher-payments/:id')
+  async updateTeacherPayment(
+    @Param('id') id: string,
+    @Body() body: any,
+    @Req() req: Request,
+    @Res() res: Response,
+  ) {
+    if (!ensureFinanceAccess(req, res)) return;
+    try {
+      const userId = getSessionUserId(req) || '';
+      const result = await this.service.updateTeacherPayment(id, body, userId);
+      return res.json({ ok: true, data: result });
+    } catch (err: any) {
+      return res.status(422).json({ ok: false, message: err?.message || 'failed' });
+    }
+  }
+
+  @Delete('teacher-payments/:id')
+  async deleteTeacherPayment(
+    @Param('id') id: string,
+    @Req() req: Request,
+    @Res() res: Response,
+  ) {
+    if (!ensureFinanceAccess(req, res)) return;
+    try {
+      await this.service.deleteTeacherPayment(id);
+      return res.json({ ok: true });
+    } catch (err: any) {
+      return res.status(422).json({ ok: false, message: err?.message || 'failed' });
+    }
+  }
+
+  // === 其他支出 ===
+
+  @Get('other-expenses')
+  async listOtherExpenses(
+    @Query() query: any,
+    @Req() req: Request,
+    @Res() res: Response,
+  ) {
+    if (!ensureFinanceAccess(req, res)) return;
+    try {
+      const result = await this.service.listOtherExpenses(query);
+      return res.json(result);
+    } catch (err: any) {
+      return res.status(500).json({ ok: false, message: err?.message || 'failed' });
+    }
+  }
+
+  @Post('other-expenses')
+  async createOtherExpense(
+    @Body() body: any,
+    @Req() req: Request,
+    @Res() res: Response,
+  ) {
+    if (!ensureFinanceAccess(req, res)) return;
+    try {
+      const userId = getSessionUserId(req) || '';
+      const result = await this.service.createOtherExpense(body, userId);
+      return res.json({ ok: true, data: result });
+    } catch (err: any) {
+      return res.status(422).json({ ok: false, message: err?.message || 'failed' });
+    }
+  }
+
+  @Patch('other-expenses/:id')
+  async updateOtherExpense(
+    @Param('id') id: string,
+    @Body() body: any,
+    @Req() req: Request,
+    @Res() res: Response,
+  ) {
+    if (!ensureFinanceAccess(req, res)) return;
+    try {
+      const userId = getSessionUserId(req) || '';
+      const result = await this.service.updateOtherExpense(id, body, userId);
+      return res.json({ ok: true, data: result });
+    } catch (err: any) {
+      return res.status(422).json({ ok: false, message: err?.message || 'failed' });
+    }
+  }
+
+  @Delete('other-expenses/:id')
+  async deleteOtherExpense(
+    @Param('id') id: string,
+    @Req() req: Request,
+    @Res() res: Response,
+  ) {
+    if (!ensureFinanceAccess(req, res)) return;
+    try {
+      await this.service.deleteOtherExpense(id);
+      return res.json({ ok: true });
+    } catch (err: any) {
+      return res.status(422).json({ ok: false, message: err?.message || 'failed' });
+    }
+  }
+}
