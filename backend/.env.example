# NestJS 后端环境变量模板
# 复制为 backend/.env 并按本机情况填写。.env 已在 .gitignore 中。
# ConfigModule 加载顺序：backend/.env > 项目根目录 .env

# 服务端口
# 注意：Windows 上 3000 可能被 Hyper-V 动态端口池预留导致 EACCES，遇到时改用 4000/3100/8080 等
PORT=4000
OWNER_PORT=3001

# MySQL（仅当数据库可达时后端才能起来）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=lan_dual_role_system

# JWT
# 生产环境必须改成强随机串，长度 ≥ 32 字符
JWT_SECRET=please-change-me
JWT_EXPIRES_IN=2h

# 文件存储
# local：写入项目根目录 uploads/；oss：写入阿里云 OSS
OBJECT_STORAGE_DRIVER=local

# 阿里云 OSS（OBJECT_STORAGE_DRIVER=oss 时填写）
# OSS_BUCKET 是阿里云 Bucket 名；业务模块会作为 Bucket 内路径前缀：
#   <OSS_PREFIX>/post-covers/...
#   <OSS_PREFIX>/lead-captures/...
#   <OSS_PREFIX>/imports/...
#   <OSS_PREFIX>/exports/...
OSS_REGION=oss-cn-shenzhen
OSS_BUCKET=xhs-test01
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=https://xhs-test01.oss-cn-shenzhen.aliyuncs.com
OSS_PREFIX=lan-system
OSS_PRIVATE=true
OSS_SIGN_URL_EXPIRES=900
