PORT=3000
# 端口矩阵（v1.3，2026-06-04）：
#   PORT=3000            — 主入口（owner 拒绝；销售/教务/员工/主管/管理员可用）
#   OWNER_PORT=3001      — 仅 owner（admin/supervisor 改走 ALL_ROLES_PORT）
#   ALL_ROLES_PORT=3003  — 统一登录入口（除 owner 外全角色放行；owner 仍必须 3001）
# 注意 3302 被新前端 Next.js (frontend/package.json dev/start) 占用，本进程不可占用。
OWNER_PORT=3001
ALL_ROLES_PORT=3003
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=lan_dual_role_system

# 后端文件存储，生产可在 backend/.env 中覆盖
OBJECT_STORAGE_DRIVER=local
OSS_REGION=oss-cn-shenzhen
OSS_BUCKET=xhs-test01
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=https://xhs-test01.oss-cn-shenzhen.aliyuncs.com
OSS_PREFIX=lan-system
OSS_PRIVATE=true
OSS_SIGN_URL_EXPIRES=900

# C4-013 草稿加密：建议生成 32+ 字节随机字符串
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DRAFT_ENCRYPTION_KEY=change-me-in-env-32bytes!

# ── posts-metrics-refresh.js 环境变量 ─────────────────────────────
# BACKEND_URL 默认 http://127.0.0.1:8089，脚本调用 /internal-refresh-metrics 用
# POSTS_REFRESH_TIMEOUT_MS 默认 30000（单条刷新超时，毫秒）
# LOG_MAX_SIZE 默认 10MB（日志轮转阈值，bytes）
# MAX_POSTS_PER_BATCH 默认 500（每轮最大刷新条数）
