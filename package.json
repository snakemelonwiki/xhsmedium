{
  "name": "lan-dual-role-system",
  "version": "0.2.0",
  "private": true,
  "description": "运营中台 - 内容运营、客资协同、订单跟进、团队管理一体化中台",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10"
  },
  "main": "server.js",
  "scripts": {
    "start": "concurrently \"npm run start:legacy\" \"npm run start:backend\"",
    "start:dev": "concurrently \"npm run start:legacy\" \"npm run start:backend\"",
    "start:legacy": "node server.js",
    "start:backend": "cd backend && npm run start:dev",
    "start:frontend": "cd frontend && npm run build && npm run start",
    "start:frontend:dev": "concurrently --kill-others-on-fail -n frontend,warmup \"cd frontend && npm run dev\" \"node scripts/warm-frontend-routes.js\"",
    "build:frontend": "cd frontend && npm run build",
    "serve:frontend": "cd frontend && npm run start",
    "debug:link": "node scripts/debug-link.js",
    "scrape:link": "node scripts/fetch-link-metrics.js",
    "install:browsers": "playwright install chromium",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "dependencies": {
    "dotenv": "^17.4.1",
    "express": "^4.21.2",
    "express-http-proxy": "^2.1.2",
    "mysql2": "^3.21.1",
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
